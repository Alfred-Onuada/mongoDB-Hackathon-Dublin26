# Copy to .env (repo root or server/) and fill in. Loaded by `deno task dev`.

# Required. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-3.8-flash

# Required. Atlas connection string (Atlas UI > Connect > Drivers).
MONGODB_URL=

# Database holding the `documentations` collection. Without it, the server
# uses the database in MONGODB_URL, or `test` if the URL names none.
MONGODB_DB_NAME=hackathon

# Optional. Name of the Atlas Vector Search index on chunk_content.
# Defaults to autoembed_index.
# VECTOR_INDEX_NAME=autoembed_index

# Optional. Minimum vector search score (0-1) for a doc chunk to count as
# related to the code. Defaults to 0.7; tune it against your real docs.
# SIMILARITY_THRESHOLD=0.7
